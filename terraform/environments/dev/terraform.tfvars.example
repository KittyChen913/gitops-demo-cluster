# 複製為 terraform.tfvars（已由 Git 忽略）後再調整。

region              = "ap-south"
k8s_version         = "1.35"
mgmt_node_type      = "g6-standard-2"
mgmt_node_count     = 2
worker_node_type    = "g6-standard-2"
worker_node_count   = 2
write_kubeconfig_files = true

# linode_token = ""  # 建議使用：export LINODE_TOKEN="..."

# Cluster Firewall／Control Plane ACL activation與evidence-backed rules由
# config/worker-firewall/dev.json管理，不在tfvars重複定義。
