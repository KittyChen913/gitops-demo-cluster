# 複製為 terraform.tfvars（已由 Git 忽略）後再調整。

region              = "ap-south"
k8s_version         = "1.35"
mgmt_node_type      = "g6-standard-4"
mgmt_node_count     = 3
worker_node_type    = "g6-standard-4"
worker_node_count   = 3
write_kubeconfig_files = true

# linode_token = ""  # 建議使用：export LINODE_TOKEN="..."

# Cluster Firewall／Control Plane ACL activation 與 evidence-backed rules 由
# config/worker-firewall/prod.json 管理，不在 tfvars 重複定義。
